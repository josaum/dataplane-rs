      "input": "expand/type-coercion-in.json",
      "expect": "expand/type-coercion-out.json"
    },
    {
      "id": "#expand-language",
      "type": "jld:ExpandTest",
      "input": "expand/language-in.json",
      "expect": "expand/language-out.json"
    },
    {
      "id": "#expand-graph",
      "type": "jld:ExpandTest",
      "input": "expand/graph-in.json",
      "expect": "expand/graph-out.json"
    },
    {
      "id": "#expand-list",
      "type": "jld:ExpandTest",
      "input": "expand/list-in.json",
